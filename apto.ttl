###  https://w3id.org/APTO#PT0065
:PT0065 rdf:type owl:Class ;
        rdfs:subClassOf :PT0111 ,
                        :PT0113 ;
        rdfs:label "Processed animal product"@en ,
                   "Produto de origem animal processado"@pt-br ;
        skos:definition "A animal-derived product that have undergone processing, altering their physical or chemical properties."@en ,
                        "Um produto de origem animal que passou por processamento, alterando suas propriedades físicas ou químicas."@pt-br .


###  https://w3id.org/APTO#PT0066
:PT0066 rdf:type owl:Class ;
        rdfs:label "Product type"@en ,
                   "Tipo de produto"@pt-br .


###  https://w3id.org/APTO#PT0067
:PT0067 rdf:type owl:Class ;
        rdfs:subClassOf :PT0069 ,
                        :PT0111 ;
        rdfs:label "Produto de origem animal in natura"@pt-br ,
                   "Raw animal product"@en ;
        skos:definition "An Animal Product that has undergone minimal or no processing after being obtained from an animal. This category includes products that are in their natural state or have only been subjected to basic preservation methods (e.g., refrigeration, freezing, or drying) without significant transformation."@en ,
                        "Um Produto Animal que passou por nenhum ou mínimo processamento após ser obtido do animal. Esta categoria inclui produtos que estão em seu estado natural ou foram submetidos apenas a métodos básicos de preservação (ex.: refrigeração, congelamento ou secagem), sem transformação significativa."@pt-br .


###  https://w3id.org/APTO#PT0068
:PT0068 rdf:type owl:Class ;
        rdfs:subClassOf :PT0069 ,
                        :PT0112 ;
        rdfs:label "Produto de origem vegetal in natura"@pt-br ,
                   "Raw plant product"@en ;
        skos:definition "A Plant Product that has undergone minimal or no processing after being harvested from a plant. These products remain in their natural state or have only been subjected to basic preservation methods (e.g., drying, washing, or refrigeration) without significant transformation."@en ,
                        "Um Produto Vegetal que passou por nenhum ou mínimo processamento após ser colhido da planta. Esses produtos permanecem em seu estado natural ou foram submetidos apenas a métodos básicos de preservação (ex.: secagem, lavagem ou refrigeração) sem transformação significativa."@pt-br .


###  https://w3id.org/APTO#PT0069
:PT0069 rdf:type owl:Class ;
        rdfs:subClassOf :PT0066 ;
        rdfs:label "Produto in natura"@pt-br ,
                   "Raw product"@en ;
        skos:definition "A product that has undergone minimal or no industrial processing and retains its natural characteristics."@en ,
                        "Produto que passou por nenhum ou mínimo processamento industrial, mantendo suas características naturais."@pt-br ;
        skos:relatedMatch "http://aims.fao.org/aos/agrovoc/c_24887"^^xsd:anyURI .


