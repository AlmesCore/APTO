#    Classes
#################################################################

###  https://w3id.org/APTO#PT0001
:PT0001 rdf:type owl:Class ;
        rdfs:subClassOf :PT0501 ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty <http://purl.obolibrary.org/obo/BCO_0000087> ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :PT0355
                        ] ;
        rdfs:label "Assai palm"@en ,
                   "Açaí-verdadeiro"@pt-br .


###  https://w3id.org/APTO#PT0002
:PT0002 rdf:type owl:Class ;
        rdfs:subClassOf :PT0456 ;
        rdfs:label "Chilled chicken"@en ,
                   "Frango resfriado"@pt-br .


###  https://w3id.org/APTO#PT0003
:PT0003 rdf:type owl:Class ;
        rdfs:subClassOf :PT0453 ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0001001> ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :PT0079
                        ] ;
        rdfs:label "Algodão em caroço"@pt-br ,
                   "Seed cotton"@en ;
        skos:definition "Algodão bruto colhido no campo, composto tanto pelas fibras (pluma) quanto pelas sementes."@pt-br ,
                        "Raw cotton as harvested from the field, consisting of both cotton fibers (lint) and seeds."@en .


###  https://w3id.org/APTO#PT0004
:PT0004 rdf:type owl:Class ;
        rdfs:subClassOf :PT0011 ,
                        :PT0111 ;
        rdfs:label "Animal by-product"@en ,
                   "Subproduto de origem animal"@pt-br ;
        skos:definition "A secondary or residual product obtained during the processing or utilization of a primary Animal Product. While not the main intended output, an Animal By-Product retains economic, nutritional, or industrial value."@en ,
                        "Um produto secundário ou residual obtido durante o processamento ou a utilização de um Produto Animal primário. Embora não seja o principal resultado pretendido, um Subproduto Animal mantém valor econômico, nutricional ou industrial."@pt-br .


###  https://w3id.org/APTO#PT0005
:PT0005 rdf:type owl:Class ;
        rdfs:subClassOf :PT0067 ;
        rdfs:label "Aquaculture product"@en ,
                   "Produto da aquicultura"@pt-br .


###  https://w3id.org/APTO#PT0006
:PT0006 rdf:type owl:Class ;
        rdfs:subClassOf :PT0056 ,
                        :PT0548 ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty <http://purl.obolibrary.org/obo/BCO_0000087> ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :PT0222
                        ] ;
        rdfs:label "Araucaria"@en ,
                   "Araucária"@pt-br .


###  https://w3id.org/APTO#PT0007
:PT0007 rdf:type owl:Class ;
        rdfs:subClassOf :PT0418 ;
        rdfs:label "Boi gordo"@pt-br ,
                   "Finished steer"@en ;
        skos:definition "Animal que foi engordado e condicionado para o abate, geralmente alcançando uma composição ideal de músculo e gordura para a produção de carne."@pt-br ,
                        "Finished cattle are bovines that have been fattened and conditioned for slaughter, typically reaching optimal muscle and fat composition for meat production"@en ;
        skos:relatedMatch "http://dbpedia.org/resource/Fed_cattle"^^xsd:anyURI .


###  https://w3id.org/APTO#PT0008
:PT0008 rdf:type owl:Class ;
        rdfs:subClassOf :PT0418 ;
        rdfs:label "Boi magro"@pt-br ,
                   "Feeder steer"@en ;
        skos:altLabel "Lean steer"@en ;
        skos:definition "A feeder steer is a bovine that has not yet reached finishing weight and is typically raised on pasture or forage - based diets. It is in a growth phase and destined to enter a fattening system, such as a feedlot, to reach the desired condition for slaughter."@en ,
                        "Bovino que ainda não atingiu o peso ou a condição corporal ideal para o abate. Geralmente criado em regime de pasto ou alimentação forrageira, ele está em fase de crescimento e é destinado a sistemas de terminação, como o confinamento, para ser engordado até o ponto de abate."@pt-br .


###  https://w3id.org/APTO#PT0009
:PT0009 rdf:type owl:Class ;
        rdfs:subClassOf :PT0527 ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0003001> ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :PT0010
                        ] ;
        rdfs:label "Buriti"@en ,
                   "Buriti"@pt-br ;
        skos:closeMatch "https://sistemas.sede.embrapa.br/agrotermos/resources/87574e3e9216e89429f8af597b016479"^^xsd:anyURI ;
        skos:relatedMatch "http://aims.fao.org/aos/agrovoc/c_4661"^^xsd:anyURI .


###  https://w3id.org/APTO#PT0010
:PT0010 rdf:type owl:Class ;
        rdfs:subClassOf :PT0501 ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty <http://purl.obolibrary.org/obo/BCO_0000087> ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :PT0358
                        ] ;
        rdfs:label "Buriti palm"@en ,
                   "Buritizeiro"@pt-br .


###  https://w3id.org/APTO#PT0011
:PT0011 rdf:type owl:Class ;
        rdfs:subClassOf :PT0066 ;
        rdfs:label "By-product"@en ,
                   "Subproduto"@pt-br ;
        skos:definition "A secondary or residual product that results from the processing, transformation, or extraction of a primary product. Although not the main intended outcome, a by-product often retains economic, nutritional, environmental, or industrial value."@en ,
                        "Produto secundário ou residual resultante do processamento, transformação ou extração de um produto principal. Embora não seja o resultado intencional primário, um subproduto frequentemente mantém valor econômico, nutricional, ambiental ou industrial."@pt-br ;
        skos:exactMatch "http://aims.fao.org/aos/agrovoc/c_1172"^^xsd:anyURI .


###  https://w3id.org/APTO#PT0012
:PT0012 rdf:type owl:Class ;
        rdfs:subClassOf :PT0438 ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0001000> ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :PT0422
                        ] ;
        rdfs:label "Canjica de milho"@pt-br ,
                   "Hominy corn"@en ;
        skos:definition "Refere-se a grãos de milho branco ou amarelo, descascados e grosseiramente triturados ou inteiros, geralmente utilizados em preparações culinárias tradicionais"@pt-br ,
                        "Refers to dehulled and coarsely ground or whole kernels of white or yellow maize, typically used in traditional cooking."@en .


