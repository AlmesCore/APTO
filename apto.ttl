###  https://w3id.org/APTO#PT0011
:PT0011 rdf:type owl:Class ;
        rdfs:subClassOf :PT0066 ;
        rdfs:label "By-product"@en ,
                   "Subproduto"@pt-br ;
        ns1:definition "A secondary or residual product that results from the processing, transformation, or extraction of a primary product. Although not the main intended outcome, a by-product often retains economic, nutritional, environmental, or industrial value."@en ,
                       "Produto secundário ou residual resultante do processamento, transformação ou extração de um produto principal. Embora não seja o resultado intencional primário, um subproduto frequentemente mantém valor econômico, nutricional, ambiental ou industrial."@pt-br ;
        ns1:exactMatch "http://aims.fao.org/aos/agrovoc/c_1172"^^xsd:anyURI .


