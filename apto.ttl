@base <https://w3id.org/APTO#> .

<https://w3id.org/APTO#> rdf:type owl:Ontology ;
                          ns2:description "The Agriculture Product Types Ontology (APTO) is an ontology of types, meaning it does not contain individuals and is intended as a classification system for agricultural commodities price index databases in Brazil. This ontology contains labels and comments in both Portuguese and English. There are two main modules: :Organism and :Product_type. The :Organism class contains subclasses that represent the taxonomy of species related to the production of given product types. It imports taxonomic information from the Global Biodiversity Information Facility (GBIF) Backbone Taxonomy via API. The :Product_type class has six main subclasses organized into major groups: :Inorganic_compound :Animal_product :Plant_product :Raw_product :Processed_product :By-product The :Animal_product and :Plant_product classes include subclasses indicating the type of processing the product has undergone."@en ;
                          ns2:identifier "https://w3id.org/APTO#"^^xsd:anyURI ;
                          ns2:relation "http://aims.fao.org/aos/agrovoc/"^^xsd:anyURI ,
                                       "https://sistemas.sede.embrapa.br/agrotermos/"^^xsd:anyURI ;
                          ns2:rights "CC-BY-4.0" ;
                          ns2:source "https://doi.org/10.5281/zenodo.15008549"^^xsd:anyURI ;
                          ns2:subject "Agriculture"^^rdfs:Literal ,
                                      "Ontology"^^rdfs:Literal ,
                                      "Product types"^^rdfs:Literal ;
                          ns3:contributor "Alexandre Cláudio Botazzo Delbem" ,
                                          "Antonio Mauro Saraiva" ,
                                          "Debora Pignatari Drucker" ,
                                          "Dilvan de Abreu Moreira" ,
                                          "Fernando Elias Corrêa" ,
                                          "Kelly Rosa Braghetto" ,
                                          "Luiz Olavo Bonino da Silva Santos" ,
                                          "Luís Ferreira Pires" ;
                          ns3:creator "Filipi Miranda Soares" ;
                          ns3:hasFormat "https://data.pldn.nl/FilipiSoares/APTO"^^xsd:anyURI ;
                          ns3:issued "2024-10-15"^^xsd:date ;
                          ns3:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
                          ns3:modified "2025-03-07"^^xsd:date ;
                          ns3:title "Agriculture Product Types Ontology (APTO)" ;
                          ns4:specializes "http://aims.fao.org/aos/agrovoc/"^^xsd:anyURI ,
                                          "https://sistemas.sede.embrapa.br/agrotermos/"^^xsd:anyURI ;
                          owl:versionInfo "1.31"^^xsd:float ;
                          ns5:includedInDataCatalog "https://agroportal.lirmm.fr/"^^xsd:anyURI .

