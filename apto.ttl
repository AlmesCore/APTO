xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.obolibrary.org/obo/BCO_0000087
<http://purl.obolibrary.org/obo/BCO_0000087> rdf:type owl:ObjectProperty ;
                                             rdfs:label "member of taxon"@en ,
                                                        "membro do táxon"@pt-br ;
                                             skos:definition "A shortcut relation from an organsimal entity to a taxon."@en ,
                                                             "Uma relação abreviada de uma entidade organismal para um táxon."@pt-br .


###  http://purl.obolibrary.org/obo/BFO_0000050
<http://purl.obolibrary.org/obo/BFO_0000050> rdf:type owl:ObjectProperty ;
                                             owl:inverseOf <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                             rdf:type owl:TransitiveProperty ;
                                             rdfs:label "part of"@en ;
                                             skos:definition "A core relation that holds between a part and its whole"@en .


###  http://purl.obolibrary.org/obo/BFO_0000051
<http://purl.obolibrary.org/obo/BFO_0000051> rdf:type owl:ObjectProperty ,
                                                      owl:TransitiveProperty ;
                                             rdfs:label "has part"@en ;
                                             skos:definition "A core relation that holds between a whole and its part"@en .


###  http://purl.obolibrary.org/obo/RO_0001000
<http://purl.obolibrary.org/obo/RO_0001000> rdf:type owl:ObjectProperty ;
                                            owl:inverseOf <http://purl.obolibrary.org/obo/RO_0001001> ;
                                            rdf:type owl:InverseFunctionalProperty ;
                                            rdfs:comment "A relation between two distinct material entities, the new entity and the old entity, in which the new entity begins to exist when the old entity ceases to exist, and the new entity inherits the significant portion of the matter of the old entity."@en ,
                                                         "Uma relação entre duas entidades materiais distintas, a nova entidade e a entidade antiga, na qual a nova entidade começa a existir quando a entidade antiga deixa de existir, e a nova entidade herda a porção significativa da matéria da entidade antiga."@pt-br ;
                                            rdfs:label "derivado de"@pt-br ,
                                                       "derives from"@en .


###  http://purl.obolibrary.org/obo/RO_0001001
<http://purl.obolibrary.org/obo/RO_0001001> rdf:type owl:ObjectProperty ;
                                            rdfs:comment "A relation between two distinct material entities, the old entity and the new entity, in which the new entity begins to exist when the old entity ceases to exist, and the new entity inherits the significant portion of the matter of the old entity."@en ,
                                                         "Uma relação entre duas entidades materiais distintas, a entidade antiga e a nova entidade, na qual a nova entidade começa a existir quando a entidade antiga deixa de existir, e a nova entidade herda a porção significativa da matéria da entidade antiga."@pt-br ;
                                            rdfs:label "deriva em"@pt-br ,
                                                       "derives into"@en .


###  http://purl.obolibrary.org/obo/RO_0003000
<http://purl.obolibrary.org/obo/RO_0003000> rdf:type owl:ObjectProperty ;
                                            owl:inverseOf <http://purl.obolibrary.org/obo/RO_0003001> ;
                                            rdfs:label "produces"@en ,
                                                       "produz"@pt-br ;
                                            skos:definition "A produces B if some process that occurs_in A has_output B, where A and B are material entities."@en ,
                                                            "A produz B se algum processo que ocorre em A tem B como resultado, onde A e B são entidades materiais."@pt-br .


###  http://purl.obolibrary.org/obo/RO_0003001
<http://purl.obolibrary.org/obo/RO_0003001> rdf:type owl:ObjectProperty ;
                                            rdfs:label "produced by"@en ,
                                                       "produzido por"@pt-br ;
                                            skos:definition "A produced_by B iff some process that occurs_in B has_output A."@en ,
                                                            "A é produzido por B se, e somente se, algum processo que ocorre em B tem A como resultado."@pt-br .


###  https://w3id.org/APTO#PT0405
:PT0405 rdf:type owl:ObjectProperty ;
        owl:inverseOf :PT0407 ;
        rdfs:domain :PT0113 ;
        rdfs:range :PT0066 ;
        rdfs:label "contém ingrediente"@pt-br ,
                   "has ingredient"@en ;
        skos:definition "Esta propriedade indica que um produto contém um ou mais ingredientes específicos."@pt-br ,
                        "This property indicates that a product contains one or more specific ingredients."@en .


###  https://w3id.org/APTO#PT0406
:PT0406 rdf:type owl:ObjectProperty ;
        rdfs:domain :PT0051 ;
        rdfs:label "is a hybrid of"@en ,
                   "é um híbrido de"@pt-br ;
        skos:definition "Esta propriedade indica que uma dada espécie é um híbrido de outras duas espécies."@pt-br ,
                        "This property indicates that a given species is a hybrid of two other species."@en .


###  https://w3id.org/APTO#PT0407
:PT0407 rdf:type owl:ObjectProperty ;
        rdfs:domain :PT0066 ;
        rdfs:range :PT0113 ;
        rdfs:label "is ingredient of"@en ,
                   "é ingrediente de"@pt-br ;
        skos:definition "Esta propriedade indica que algo é um ingrediente de um produto específico."@pt-br ,
                        "This property indicates that something is an ingredient of a specific product."@en .


###  https://w3id.org/APTO#PT0408
:PT0408 rdf:type owl:ObjectProperty ;
        rdfs:domain :PT0011 ;
        rdfs:range :PT0066 ;
        rdfs:label "residue of"@en ,
                   "resíduo da produção de"@pt-br ;
        skos:definition "A propriedade \"residue_of\" liga um subproduto ao produto cuja produção resulta nesse subproduto. Essa relação indica que o subproduto é um resíduo gerado durante o processo de produção do produto principal."@pt-br ,
                        "The \"residue_of\" property links a by-product to the product whose production results in this by-product. This relationship indicates that the by-product is a residue generated during the manufacturing process of the main product."@en .


