@base <https://w3id.org/APTO#> .

<https://w3id.org/APTO#> rdf:type owl:Ontology ;
                          dc:description "The Agriculture Product Types Ontology (APTO) is an ontology of types, meaning it does not contain individuals and is intended as a classification system for agricultural commodities price index databases in Brazil. This ontology contains labels and comments in both Portuguese and English. There are two main modules: :Organism and :Product_type. The :Organism class contains subclasses that represent the taxonomy of species related to the production of given product types. It imports taxonomic information from the Global Biodiversity Information Facility (GBIF) Backbone Taxonomy via API. The :Product_type class has six main subclasses organized into major groups: :Inorganic_compound :Animal_product :Plant_product :Raw_product :Processed_product :By-product The :Animal_product and :Plant_product classes include subclasses indicating the type of processing the product has undergone."@en ;
                          dc:identifier "https://w3id.org/APTO#"^^xsd:anyURI ;
                          dc:relation "http://aims.fao.org/aos/agrovoc/"^^xsd:anyURI ,
                                      "https://sistemas.sede.embrapa.br/agrotermos/"^^xsd:anyURI ;
                          dc:rights "CC-BY-4.0" ;
                          dc:source "https://doi.org/10.5281/zenodo.15008549"^^xsd:anyURI ;
                          dc:subject "Agriculture"^^rdfs:Literal ,
                                     "Ontology"^^rdfs:Literal ,
                                     "Product types"^^rdfs:Literal ;
                          dcterms:contributor "Alexandre Cláudio Botazzo Delbem" ,
                                              "Antonio Mauro Saraiva" ,
                                              "Debora Pignatari Drucker" ,
                                              "Dilvan de Abreu Moreira" ,
                                              "Fernando Elias Corrêa" ,
                                              "Kelly Rosa Braghetto" ,
                                              "Luiz Olavo Bonino da Silva Santos" ,
                                              "Luís Ferreira Pires" ;
                          dcterms:creator "Filipi Miranda Soares" ;
                          dcterms:hasFormat "https://data.pldn.nl/FilipiSoares/APTO"^^xsd:anyURI ;
                          dcterms:issued "2024-10-15"^^xsd:date ;
                          dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
                          dcterms:modified "2025-08-01" ;
                          dcterms:title "Agriculture Product Types Ontology (APTO)" ;
                          owl:versionInfo "1.3"^^xsd:float ;
                          sdo:includedInDataCatalog "https://agroportal.lirmm.fr/"^^xsd:anyURI .

