###  https://w3id.org/APTO#PT0007
:PT0007 rdf:type owl:Class ;
        rdfs:subClassOf <http://aims.fao.org/aos/agrovoc/c_1147> ;
        rdfs:label "Boi gordo"@pt-br ,
                   "Finished steer"@en ;
        ns1:definition "Animal que foi engordado e condicionado para o abate, geralmente alcançando uma composição ideal de músculo e gordura para a produção de carne."@pt-br ,
                       "Finished cattle are bovines that have been fattened and conditioned for slaughter, typically reaching optimal muscle and fat composition for meat production"@en ;
        ns1:relatedMatch "http://dbpedia.org/resource/Fed_cattle"^^xsd:anyURI .


###  https://w3id.org/APTO#PT0008
:PT0008 rdf:type owl:Class ;
        rdfs:subClassOf <http://aims.fao.org/aos/agrovoc/c_1147> ;
        rdfs:label "Boi magro"@pt-br ,
                   "Feeder steer"@en ;
        ns1:altLabel "Lean steer"@en ;
        ns1:definition "A feeder steer is a bovine that has not yet reached finishing weight and is typically raised on pasture or forage - based diets. It is in a growth phase and destined to enter a fattening system, such as a feedlot, to reach the desired condition for slaughter."@en ,
                       "Bovino que ainda não atingiu o peso ou a condição corporal ideal para o abate. Geralmente criado em regime de pasto ou alimentação forrageira, ele está em fase de crescimento e é destinado a sistemas de terminação, como o confinamento, para ser engordado até o ponto de abate."@pt-br .


