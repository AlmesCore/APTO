###  https://w3id.org/APTO#PT0115
:PT0115 rdf:type owl:Class ;
        rdfs:subClassOf :PT0112 ;
        rdfs:comment "A plant that provides direct or indirect benefits to humans, animals, or the environment. These benefits may include food, medicine, raw materials, fuel, ecological services, or ornamental value."@en ;
        rdfs:label "Planta útil"@pt-br ,
                   "Useful plant"@en ;
        skos:exactMatch "http://aims.fao.org/aos/agrovoc/c_995ecefb"^^xsd:anyURI .


###  https://w3id.org/APTO#PT0116
:PT0116 rdf:type owl:Class ;
        rdfs:subClassOf :PT0111 ;
        rdfs:comment "An animal that provides direct or indirect benefits to humans or ecosystems. These benefits may include food, labor, companionship, raw materials, pest control, or ecological balance. Examples include cattle for milk and meat, bees for pollination, horses for transportation, and earthworms for soil enrichment."@en ;
