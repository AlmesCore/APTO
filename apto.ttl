###  https://w3id.org/APTO#PT0074
:PT0074 rdf:type owl:Class ;
        rdfs:subClassOf :PT0114 ;
        rdfs:label "Sucroenergético"@pt-br ,
                   "Sugar-energy"@en ;
        skos:definition "A sugar-energy product is a product derived from sugar-rich crops such as sugarcane, sugar beet, or maize, intended for food, fuel, or energy production."@en ,
                        "Produto derivado de culturas ricas em açúcares, como a cana-de-açúcar, a beterraba ou o milho, destinado à alimentação, à produção de combustíveis ou à geração de energia."@pt-br .


###  https://w3id.org/APTO#PT0075
:PT0075 rdf:type owl:Class ;
        rdfs:subClassOf :PT0115 ;
        rdfs:label "Planta produtora de açúcar"@pt-br ,
                   "Sugar-producing plant"@en ;
        skos:definition "A plant cultivated primarily for its high natural sugar content, which can be extracted and processed into sweeteners such as raw sugar, refined sugar, or ethanol."@en ,
                        "Planta cultivada principalmente por seu alto teor natural de açúcar, que pode ser extraído e processado na forma de adoçantes como açúcar bruto, açúcar refinado ou etanol."@pt-br .


