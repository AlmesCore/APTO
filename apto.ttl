###  https://w3id.org/APTO#PT0055
:PT0055 rdf:type owl:Class ;
        rdfs:subClassOf :PT0011 ,
                        :PT0112 ;
        rdfs:label "Plant by-product"@en ,
                   "Subproduto de origem vegetal"@pt-br ;
        skos:definition "A secondary or residual product obtained during the processing or extraction of a primary Plant Product. While not the main intended output, a Plant By-Product retains economic, nutritional, or industrial value."@en ,
                        "Um produto secundário ou residual obtido durante o processamento ou extração de um Produto Vegetal primário. Embora não seja o principal resultado pretendido, um Subproduto Vegetal mantém valor econômico, nutricional ou industrial."@pt-br .


