###  https://w3id.org/APTO#PT0065
:PT0065 rdf:type owl:Class ;
        rdfs:subClassOf <http://aims.fao.org/aos/agrovoc/c_15742> ,
                        <http://aims.fao.org/aos/agrovoc/c_438> ;
        rdfs:label "Processed animal product"@en ,
                   "Produto de origem animal processado"@pt-br ;
        ns1:definition "A animal-derived product that have undergone processing, altering their physical or chemical properties."@en ,
                       "Um produto de origem animal que passou por processamento, alterando suas propriedades físicas ou químicas."@pt-br .


###  https://w3id.org/APTO#PT0066
:PT0066 rdf:type owl:Class ;
        rdfs:label "Product type"@en ,
                   "Tipo de produto"@pt-br .


###  https://w3id.org/APTO#PT0067
:PT0067 rdf:type owl:Class ;
        rdfs:subClassOf <http://aims.fao.org/aos/agrovoc/c_438> ,
                        :PT0069 ;
        rdfs:label "Produto de origem animal in natura"@pt-br ,
                   "Raw animal product"@en ;
        ns1:definition "An Animal Product that has undergone minimal or no processing after being obtained from an animal. This category includes products that are in their natural state or have only been subjected to basic preservation methods (e.g., refrigeration, freezing, or drying) without significant transformation."@en ,
                       "Um Produto Animal que passou por nenhum ou mínimo processamento após ser obtido do animal. Esta categoria inclui produtos que estão em seu estado natural ou foram submetidos apenas a métodos básicos de preservação (ex.: refrigeração, congelamento ou secagem), sem transformação significativa."@pt-br .


###  https://w3id.org/APTO#PT0068
:PT0068 rdf:type owl:Class ;
        rdfs:subClassOf <http://aims.fao.org/aos/agrovoc/c_8171> ,
                        :PT0069 ;
        rdfs:label "Produto de origem vegetal in natura"@pt-br ,
                   "Raw plant product"@en ;
        ns1:definition "A Plant Product that has undergone minimal or no processing after being harvested from a plant. These products remain in their natural state or have only been subjected to basic preservation methods (e.g., drying, washing, or refrigeration) without significant transformation."@en ,
                       "Um Produto Vegetal que passou por nenhum ou mínimo processamento após ser colhido da planta. Esses produtos permanecem em seu estado natural ou foram submetidos apenas a métodos básicos de preservação (ex.: secagem, lavagem ou refrigeração) sem transformação significativa."@pt-br .


###  https://w3id.org/APTO#PT0069
:PT0069 rdf:type owl:Class ;
        rdfs:subClassOf :PT0066 ;
        rdfs:label "Produto in natura"@pt-br ,
                   "Raw product"@en ;
        ns1:definition "A product that has undergone minimal or no industrial processing and retains its natural characteristics."@en ,
                       "Produto que passou por nenhum ou mínimo processamento industrial, mantendo suas características naturais."@pt-br ;
        ns1:relatedMatch "http://aims.fao.org/aos/agrovoc/c_24887"^^xsd:anyURI .


###  https://w3id.org/APTO#PT0070
:PT0070 rdf:type owl:Class ;
        rdfs:subClassOf :PT0032 ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0001000> ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass <http://aims.fao.org/aos/agrovoc/c_6599>
                        ] ;
        rdfs:label "Flocos de arrroz"@pt-br ,
                   "Rice flakes"@en ;
        ns1:definition "Flocos de arroz são grãos de arroz que foram processados para se tornarem finos e achatados. Este processo envolve cozinhar os grãos, desidratá-los e prensá-los, resultando em flocos leves e crocantes. Eles são comumente usados em cereais matinais, barras de cereais e podem ser consumidos com leite, iogurte ou utilizados em receitas como bolos e biscoitos."@pt-br ,
                       "Rice flakes are grains of rice that have been processed to become thin and flattened. This process involves cooking the grains, dehydrating them, and pressing them, resulting in light and crispy flakes. They are commonly used in breakfast cereals, cereal bars, and can be eaten with milk, yogurt, or used in recipes like cakes and cookies."@en .


